generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AIItineraryStatus {
  PENDING
  GENERATED
  FAILED
  REGENERATED
}

enum ApiProvider {
  REST_COUNTRIES
  OPENTRIPMAP
  VERTEX_AI
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  preferences   Preference?
  trips         Trip[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Preference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  travelStyle        String?
  budgetRange        String?
  interests          Json?
  preferredTransport String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Country {
  id           String   @id @default(cuid())
  isoCode      String   @unique
  iso3Code     String   @unique
  name         String
  capital      String?
  currency     String?
  continent    String?
  population   BigInt?
  flagUrl      String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  lastSynced   DateTime @default(now())
  attractions  AttractionCache[]
  trips        Trip[]
}

model AttractionCache {
  id            String   @id @default(cuid())
  countryId     String
  openTripMapId String   @unique
  name          String
  category      String
  latitude      Decimal  @db.Decimal(9, 6)
  longitude     Decimal  @db.Decimal(9, 6)
  imageUrl      String?
  rawJson       Json
  lastFetched   DateTime @default(now())
  expiresAt     DateTime
  country       Country  @relation(fields: [countryId], references: [id])
  tripDestinations TripDestination[]

  @@index([countryId])
  @@index([expiresAt])
}

model Trip {
  id          String   @id @default(cuid())
  userId      String
  countryId   String
  title       String
  description String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  status      TripStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country  @relation(fields: [countryId], references: [id])
  destinations TripDestination[]
  aiItineraries AIItinerary[]
  budget      Budget?

  @@index([userId])
  @@index([countryId])
}

model TripDestination {
  id                String   @id @default(cuid())
  tripId            String
  attractionCacheId String
  dayNumber         Int?
  visitOrder        Int?
  notes             String?  @db.Text
  trip              Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attraction        AttractionCache @relation(fields: [attractionCacheId], references: [id])

  @@index([tripId])
}

model AIItinerary {
  id            String            @id @default(cuid())
  tripId        String
  model         String
  promptVersion String
  itinerary     Json
  generatedAt   DateTime          @default(now())
  status        AIItineraryStatus @default(PENDING)
  trip          Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Budget {
  id            String   @id @default(cuid())
  tripId        String   @unique
  hotel         Decimal? @db.Decimal(10, 2)
  transport     Decimal? @db.Decimal(10, 2)
  food          Decimal? @db.Decimal(10, 2)
  activities    Decimal? @db.Decimal(10, 2)
  miscellaneous Decimal? @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  currency      String
  calculatedAt  DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ApiRequestLog {
  id             String      @id @default(cuid())
  provider       ApiProvider
  endpoint       String
  method         String
  statusCode     Int
  responseTimeMs Int
  success        Boolean
  errorMessage   String?     @db.Text
  createdAt      DateTime    @default(now())
}
