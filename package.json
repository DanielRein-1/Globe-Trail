{
  "name": "globetrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:countries": "node --import ./scripts/typescript-loader.mjs --env-file-if-exists=.env prisma/seed.ts",
    "test:countries": "node --import ./scripts/typescript-loader.mjs --test --test-isolation=none tests/countries.test.mjs",
    "test:countries:ui": "node --import ./scripts/typescript-loader.mjs scripts/country-ui-fixtures.mjs",
    "test:attractions": "node --import ./scripts/typescript-loader.mjs --test --test-isolation=none tests/attractions.test.mjs",
    "test:site": "node --import ./scripts/typescript-loader.mjs --test --test-isolation=none tests/site.test.mjs",
    "test:itineraries": "node --import ./scripts/typescript-loader.mjs --test --test-isolation=none tests/itineraries.test.mjs",
    "test:destinations": "node --import ./scripts/typescript-loader.mjs --test --test-isolation=none tests/destinations.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "prisma": "^6.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
